<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/editStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter student's first name"
        android:inputType="text" />

    <EditText
        android:id="@+id/editStudentSurname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter student's last name"
        android:inputType="text"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/editStudentAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter student's age"
        android:inputType="number"
        android:layout_marginTop="8dp" />

    <Spinner
        android:id="@+id/spinnerGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnSaveStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Student"
        android:layout_marginTop="16dp" />
</LinearLayout>
